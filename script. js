// Mobile Navigation Toggle
const menuToggle = document.getElementById('menuToggle');
const navLinks = document.getElementById('navLinks');

menuToggle.addEventListener('click', () => {
  navLinks.classList.toggle('active');
});

// Interactive Neural Handshake Terminal Simulation
const connectBtn = document.getElementById('connectBtn');
const navCta = document.getElementById('navCta');
const terminalOutput = document.getElementById('terminalOutput');

const bootSequence = [
  '> [INIT] Establishing encrypted neural bridge...',
  '> [BIO-CHECK] Heart rate: 68 BPM | Cortical load: OPTIMAL',
  '> [CALIBRATE] Synchronizing Ocular HUD Mk-IV...',
  '> [SUCCESS] CONNECTION ESTABLISHED — WELCOME TO NEON-X.'
];

function runNeuralSync() {
  terminalOutput.innerHTML = '';
  connectBtn.disabled = true;
  connectBtn.textContent = 'SYNCING...';

  bootSequence.forEach((line, index) => {
    setTimeout(() => {
      const p = document.createElement('p');
      p.textContent = line;
      if (index === bootSequence.length - 1) {
        p.style.color = '#00f0ff';
        p.style.fontWeight = 'bold';
        connectBtn.disabled = false;
        connectBtn.textContent = 'RE-CALIBRATE LINK';
      }
      terminalOutput.appendChild(p);
    }, index * 650);
  });
}

connectBtn.addEventListener('click', runNeuralSync);
navCta.addEventListener('click', () => {
  document.getElementById('terminal').scrollIntoView({ behavior: 'smooth' });
  runNeuralSync();
});