:root {
  --bg-dark: #05060a;
  --panel-bg: rgba(14, 18, 30, 0.72);
  --cyan: #00f0ff;
  --magenta: #ff2a85;
  --green: #00ff88;
  --text-main: #e6f1ff;
  --text-muted: #8892b0;
  --border-glow: rgba(0, 240, 255, 0.3);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background-color: var(--bg-dark);
  color: var(--text-main);
  font-family: 'Rajdhani', sans-serif;
  overflow-x: hidden;
  line-height: 1.6;
}

/* Futuristic Grid & Scanlines */
.cyber-grid {
  position: fixed;
  inset: 0;
  background-image: 
    linear-gradient(to right, rgba(0, 240, 255, 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(0, 240, 255, 0.05) 1px, transparent 1px);
  background-size: 45px 45px;
  z-index: -2;
}

.scanlines {
  position: fixed;
  inset: 0;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
  background-size: 100% 4px;
  pointer-events: none;
  z-index: 999;
}

/* Typography & Buttons */
h1, h2, h3, .logo {
  font-family: 'Orbitron', sans-serif;
  letter-spacing: 1.5px;
}

.btn-primary, .btn-secondary, .btn-outline {
  display: inline-block;
  padding: 0.85rem 1.75rem;
  font-family: 'Orbitron', sans-serif;
  font-size: 0.85rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: all 0.25s ease;
  clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
}

.btn-primary {
  background: var(--cyan);
  color: #05060a;
  border: none;
  box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
}

.btn-primary:hover {
  background: #ffffff;
  box-shadow: 0 0 30px var(--cyan);
  transform: translateY(-2px);
}

.btn-secondary {
  background: transparent;
  color: var(--magenta);
  border: 1px solid var(--magenta);
}

.btn-secondary:hover {
  background: rgba(255, 42, 133, 0.15);
  box-shadow: 0 0 20px rgba(255, 42, 133, 0.4);
}

.btn-outline {
  background: transparent;
  color: var(--cyan);
  border: 1px solid var(--cyan);
  padding: 0.55rem 1.2rem;
}

.btn-outline:hover {
  background: var(--cyan);
  color: var(--bg-dark);
}

/* Navbar */
.navbar {
  position: sticky;
  top: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 6%;
  background: rgba(5, 6, 10, 0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-glow);
  z-index: 100;
}

.logo {
  font-size: 1.5rem;
  font-weight: 900;
  color: #fff;
}

.logo span { color: var(--cyan); }
.logo small { font-size: 0.7rem; color: var(--magenta); }

.nav-links {
  display: flex;
  gap: 2rem;
}

.nav-links a {
  color: var(--text-main);
  text-decoration: none;
  font-weight: 600;
  font-size: 1.05rem;
  text-transform: uppercase;
  transition: color 0.2s;
}

.nav-links a:hover { color: var(--cyan); }

.menu-toggle {
  display: none;
  background: none;
  border: none;
  color: var(--cyan);
  font-size: 1.8rem;
  cursor: pointer;
}

/* Hero Section */
.hero {
  min-height: 88vh;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  align-items: center;
  gap: 3rem;
  padding: 4rem 6%;
}

.hud-badge {
  display: inline-block;
  color: var(--green);
  border: 1px solid rgba(0, 255, 136, 0.4);
  background: rgba(0, 255, 136, 0.08);
  padding: 0.35rem 0.9rem;
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 1.2rem;
}

.hero h1 {
  font-size: clamp(2.4rem, 5vw, 4.2rem);
  line-height: 1.1;
  margin-bottom: 1.2rem;
  text-shadow: 2px 0 var(--magenta), -2px 0 var(--cyan);
}

.hero p {
  font-size: 1.2rem;
  color: var(--text-muted);
  max-width: 560px;
  margin-bottom: 2rem;
}

.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

/* Animated Cybernetic Core */
.hero-visual {
  display: flex;
  justify-content: center;
  align-items: center;
}

.cyber-core {
  position: relative;
  width: 300px;
  height: 300px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ring {
  position: absolute;
  border-radius: 50%;
  border: 2px solid transparent;
}

.ring-1 {
  inset: 0;
  border-top-color: var(--cyan);
  border-bottom-color: var(--cyan);
  animation: spin 8s linear infinite;
}

.ring-2 {
  inset: 25px;
  border-left-color: var(--magenta);
  border-right-color: var(--magenta);
  animation: spinReverse 5s linear infinite;
}

.ring-3 {
  inset: 55px;
  border: 1px dashed rgba(0, 240, 255, 0.5);
  animation: spin 12s linear infinite;
}

.core-center {
  text-align: center;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.2), transparent 70%);
  padding: 2rem;
  border-radius: 50%;
}

.core-center span {
  display: block;
  font-family: 'Orbitron', sans-serif;
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--cyan);
}

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes spinReverse { to { transform: rotate(-360deg); } }

/* Telemetry Stats Bar */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  padding: 2.5rem 6%;
  background: var(--panel-bg);
  border-top: 1px solid var(--border-glow);
  border-bottom: 1px solid var(--border-glow);
  text-align: center;
}

.stat-item h2 {
  color: var(--cyan);
  font-size: 2rem;
}

.stat-item p {
  color: var(--text-muted);
  font-weight: 600;
  letter-spacing: 1px;
}

/* Augmentation Cards */
.systems {
  padding: 5rem 6%;
}

.section-header {
  text-align: center;
  margin-bottom: 3.5rem;
}

.sub-tag {
  color: var(--magenta);
  font-weight: 700;
  letter-spacing: 2px;
}

.section-header h2 {
  font-size: 2.4rem;
  margin-top: 0.4rem;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 2rem;
}

.cyber-card {
  position: relative;
  background: var(--panel-bg);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-glow);
  padding: 2.2rem;
  transition: transform 0.3s ease, border-color 0.3s ease;
  clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));
}

.cyber-card:hover {
  transform: translateY(-8px);
  border-color: var(--cyan);
  box-shadow: 0 10px 30px rgba(0, 240, 255, 0.15);
}

.card-corner {
  font-family: 'Orbitron', sans-serif;
  color: var(--magenta);
  font-weight: 900;
  font-size: 1.2rem;
  margin-bottom: 1rem;
}

.cyber-card h3 {
  margin-bottom: 0.8rem;
  color: #fff;
}

.cyber-card p {
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.status-tag {
  font-size: 0.85rem;
  color: var(--green);
  font-weight: 700;
}

/* Terminal Console */
.terminal-section {
  padding: 2rem 6% 6rem;
}

.terminal-box {
  max-width: 820px;
  margin: 0 auto;
  background: #090c14;
  border: 1px solid var(--cyan);
  box-shadow: 0 0 25px rgba(0, 240, 255, 0.15);
}

.terminal-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.8rem 1.2rem;
  background: #111625;
  border-bottom: 1px solid var(--border-glow);
}

.dot { width: 11px; height: 11px; border-radius: 50%; }
.red { background: #ff5f56; }
.yellow { background: #ffbd2e; }
.green { background: #27c93f; }

.terminal-title {
  margin-left: 0.6rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.terminal-body {
  padding: 1.5rem;
  min-height: 160px;
  font-family: monospace;
  color: var(--green);
  font-size: 0.95rem;
}

.terminal-body p { margin-bottom: 0.45rem; }

.terminal-controls {
  padding: 1rem 1.5rem 1.5rem;
}

footer {
  text-align: center;
  padding: 2rem;
  border-top: 1px solid var(--border-glow);
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* Responsive Media Queries */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero p { margin: 0 auto 2rem; }
  .hero-actions { justify-content: center; }
  .stats-bar { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 650px) {
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    background: #080a12;
    padding: 1.5rem;
    border-bottom: 1px solid var(--cyan);
  }
  .nav-links.active { display: flex; }
  .menu-toggle { display: block; }
  .btn-outline { display: none; }
  .cyber-core { width: 230px; height: 230px; }
}